# CI Container for Suckless-OGL
# Consolidates all dependencies to speed up GitHub Actions setup.

FROM ubuntu:24.04

# Avoid interactive prompts during apt-get
ENV DEBIAN_FRONTEND=noninteractive

# 1. Install System Dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    clang \
    libclang-rt-dev \
    llvm \
    clang-tidy \
    iwyu \
    git \
    ccache \
    ninja-build \
    just \
    libgl1-mesa-dev \
    libglew-dev \
    libglfw3-dev \
    libxinerama-dev \
    libxcursor-dev \
    libxi-dev \
    libxrandr-dev \
    xorg-dev \
    xvfb \
    libcapstone-dev \
    libdbus-1-dev \
    pkg-config \
    libssl-dev \
    libgl1-mesa-dri \
    mesa-vulkan-drivers \
    glslang-tools \
    imagemagick \
    gamemode-dev \
    doxygen \
    graphviz \
    python3 \
    python3-pip \
    ca-certificates \
    curl \
    gnupg \
    tzdata \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Récupération du binaire uv précompilé (ultra-rapide, zéro dépendance)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# uv pip install --system nécessite aussi de casser explicitement la protection PEP 668
RUN uv pip install --system --break-system-packages --no-cache \
    basedpyright \
    clang-format==22.1.5 \
    ruff \
    pytest \
    pytest-cov \
    Pillow \
    mkdocs \
    mkdocs-material \
    mkdocs-kroki-plugin \
    mkdocs-git-revision-date-localized-plugin \
    mkdocs-redirects \
    mkdocs-glightbox \
    mkdocs-static-i18n \
    tzdata

# 3. Pre-build Tracy CLI Tools (Capture & CSV Export)
# On copie la dépendance locale plutôt que de cloner pour garantir la cohérence des versions
COPY deps/tracy /tmp/tracy
RUN echo "Building Tracy CLI Tools..." && \
    # Empêcher Tracy d'utiliser -march=native pour garantir la portabilité de l'image Docker sur tout le parc CI
    find /tmp/tracy -type f \( -name "CMakeLists.txt" -o -name "*.cmake" \) -exec sed -i 's/-march=native//g' {} + && \
    # Build Capture
    cmake -B /tmp/tracy/capture/build -S /tmp/tracy/capture -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /tmp/tracy/capture/build --parallel $(nproc) && \
    cp /tmp/tracy/capture/build/tracy-capture /usr/local/bin/ && \
    # Build CSV Export
    cmake -B /tmp/tracy/csvexport/build -S /tmp/tracy/csvexport -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /tmp/tracy/csvexport/build --parallel $(nproc) && \
    cp /tmp/tracy/csvexport/build/tracy-csvexport /usr/local/bin/ && \
    # Cleanup
    rm -rf /tmp/tracy

# 4. Environment Setup
RUN useradd -m -u 1001 ciuser && \
    mkdir -p /home/ciuser/.cache/ccache && \
    chown -R ciuser:ciuser /home/ciuser

# Add ~/.local/bin to PATH for pip-installed tools
ENV PATH="/home/ciuser/.local/bin:${PATH}"

# Enable CCACHE by default for CI speed
ENV CCACHE_DIR="/home/ciuser/.cache/ccache"

WORKDIR /workspace
RUN chown ciuser:ciuser /workspace

USER ciuser

CMD ["/bin/bash"]
