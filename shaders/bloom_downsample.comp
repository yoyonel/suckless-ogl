#version 450 core

/**
 * Bloom Single-Pass Downsampler (SPD)
 * Generates multiple mip levels in a single compute dispatch.
 * Uses a 13-tap Karis filter for stable downsampling.
 * Integrated: Auto-Exposure luminance calculation.
 */

layout(local_size_x = 8, local_size_y = 8) in;

// Mip 0 (Source)
layout(binding = 0) uniform sampler2D srcTexture;

// Output Mips (1 to 5)
layout(binding = 1, r11f_g11f_b10f) uniform writeonly image2D outMip1;
layout(binding = 2, r11f_g11f_b10f) uniform writeonly image2D outMip2;
layout(binding = 3, r11f_g11f_b10f) uniform writeonly image2D outMip3;
layout(binding = 4, r11f_g11f_b10f) uniform writeonly image2D outMip4;
layout(binding = 5, r11f_g11f_b10f) uniform writeonly image2D outMip5;

// Integrated Auto-Exposure: Luminance output (New)
layout(binding = 6, r32f) uniform writeonly image2D outLuminance;

uniform vec2 srcResolution;
uniform int mipCount;

shared vec3 sharedColor[64]; // 8x8 shared memory for reduction

vec3 downsample13tap(sampler2D tex, vec2 uv, vec2 texelSize) {
    // Standard 13-tap filter
    vec3 a = texture(tex, uv + vec2(-2.0, -2.0) * texelSize).rgb;
    vec3 b = texture(tex, uv + vec2( 0.0, -2.0) * texelSize).rgb;
    vec3 c = texture(tex, uv + vec2( 2.0, -2.0) * texelSize).rgb;
    vec3 d = texture(tex, uv + vec2(-2.0,  0.0) * texelSize).rgb;
    vec3 e = texture(tex, uv + vec2( 0.0,  0.0) * texelSize).rgb;
    vec3 f = texture(tex, uv + vec2( 2.0,  0.0) * texelSize).rgb;
    vec3 g = texture(tex, uv + vec2(-2.0,  2.0) * texelSize).rgb;
    vec3 h = texture(tex, uv + vec2( 0.0,  2.0) * texelSize).rgb;
    vec3 i = texture(tex, uv + vec2( 2.0,  2.0) * texelSize).rgb;
    vec3 j = texture(tex, uv + vec2(-1.0, -1.0) * texelSize).rgb;
    vec3 k = texture(tex, uv + vec2( 1.0, -1.0) * texelSize).rgb;
    vec3 l = texture(tex, uv + vec2(-1.0,  1.0) * texelSize).rgb;
    vec3 m = texture(tex, uv + vec2( 1.0,  1.0) * texelSize).rgb;

    vec3 result = e * 0.125;
    result += (a + c + g + i) * 0.03125;
    result += (b + d + f + h) * 0.0625;
    result += (j + k + l + m) * 0.125;
    return max(result, vec3(0.0));
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lid = ivec2(gl_LocalInvocationID.xy);
    uint tid = gl_LocalInvocationIndex;

    vec2 texelSize = 1.0 / srcResolution;
    vec2 uv = (vec2(gid) * 2.0 + 1.0) * texelSize;

    // --- Mip 1 ---
    vec3 color = downsample13tap(srcTexture, uv, texelSize);
    imageStore(outMip1, gid, vec4(color, 1.0));

    // Store in shared memory for further reduction
    sharedColor[tid] = color;
    memoryBarrierShared();
    barrier();

    // --- Mip 2 (Requires 2x2 blocks from Mip 1) ---
    if ((lid.x % 2 == 0) && (lid.y % 2 == 0)) {
        vec3 c1 = sharedColor[tid];
        vec3 c2 = sharedColor[tid + 1];
        vec3 c3 = sharedColor[tid + 8];
        vec3 c4 = sharedColor[tid + 9];
        vec3 combined = (c1 + c2 + c3 + c4) * 0.25;
        imageStore(outMip2, gid / 2, vec4(combined, 1.0));
        sharedColor[tid] = combined;
    }
    memoryBarrierShared();
    barrier();

    // --- Mip 3 (Requires 4x4 blocks from Mip 1) ---
    if ((lid.x % 4 == 0) && (lid.y % 4 == 0)) {
        vec3 c1 = sharedColor[tid];
        vec3 c2 = sharedColor[tid + 2];
        vec3 c3 = sharedColor[tid + 16];
        vec3 c4 = sharedColor[tid + 18];
        vec3 combined = (c1 + c2 + c3 + c4) * 0.25;
        imageStore(outMip3, gid / 4, vec4(combined, 1.0));
        sharedColor[tid] = combined;
    }
    memoryBarrierShared();
    barrier();

    // --- Mip 4 (Requires 8x8 blocks from Mip 1) ---
    if (tid == 0) {
        vec3 c1 = sharedColor[0];
        vec3 c2 = sharedColor[4];
        vec3 c3 = sharedColor[32];
        vec3 c4 = sharedColor[36];
        vec3 combined = (c1 + c2 + c3 + c4) * 0.25;
        imageStore(outMip4, gid / 8, vec4(combined, 1.0));

        // --- Integrated Luminance (AE) ---
        // Calculate average luminance of this 16x16 tile in Mip 0
        float lum = dot(combined, vec3(0.2126, 0.7152, 0.0722));
        // We write the average of tiles to the luminance texture.
        // A single dispatch already significantly reduces the image size,
        // making the final AE compute pass extremely cheap or negligible.
        imageStore(outLuminance, gid / 8, vec4(lum, 0.0, 0.0, 0.0));
    }
}
